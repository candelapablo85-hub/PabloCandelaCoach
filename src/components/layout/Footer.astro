---
import { siteConfig } from '../../data/siteConfig';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-content">
    <div class="footer-grid">
      <!-- Columna 1: Autoridad y Propuesta -->
      <div class="footer-col footer-brand">
        <span class="footer-title">{siteConfig.siteName}</span>
        <p class="footer-bio">
          Coach Ontológico y de Negocios especializado en líderes empresariales. Herramientas prácticas forjadas desde el coaching ejecutivo y la ingeniería industrial, para potenciar la gestión de equipos y resultados en planta.
        </p>
        <p class="footer-book-plug">
          Autor de <em>«{siteConfig.bookTitle}»</em>.
        </p>
      </div>

      <!-- Columna 2: Navegación -->
      <div class="footer-col">
        <h4 class="footer-heading">Navegación</h4>
        <ul class="footer-links">
          {siteConfig.navLinks.map((link) => (
            <li>
              <a 
                href={link.href} 
                class="footer-link"
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
              >
                {link.label} {link.external && <span aria-hidden="true">↗</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Columna 3: Servicios y Recursos -->
      <div class="footer-col">
        <h4 class="footer-heading">Soluciones</h4>
        <ul class="footer-links">
          <li><a href="/coaching" class="footer-link">Todas las propuestas de coaching</a></li>
          <li><a href="/coaching/autoliderazgo" class="footer-link">Libro y autoliderazgo</a></li>
          <li><a href="/coaching/emprendedores" class="footer-link">Coaching para emprendedores</a></li>
          <li><a href="/coaching/liderazgo" class="footer-link">Programa de los 5 Pilares</a></li>
          <li><a href="/coaching#faq" class="footer-link">Preguntas Frecuentes</a></li>
          <li>
            <a href="/coaching/autoliderazgo" class="footer-link">
              El libro: «{siteConfig.bookTitle}»
            </a>
          </li>
          <li><a href="/blog" class="footer-link">Artículos de Liderazgo Industrial</a></li>
        </ul>
      </div>

      <!-- Columna 4: Contacto y Redes -->
      <div class="footer-col">
        <h4 class="footer-heading">Contacto Directo</h4>
        <ul class="footer-contact-list">
          <li>
            <a href={siteConfig.whatsappUrl} target="_blank" rel="noopener noreferrer" class="footer-link flex-align">
              <span aria-hidden="true">💬</span> WhatsApp: {siteConfig.whatsappNumber}
            </a>
          </li>
          <li>
            <a href={siteConfig.linkedinUrl} target="_blank" rel="noopener noreferrer" class="footer-link flex-align">
              <span aria-hidden="true">💼</span> LinkedIn: Pablo Candela
            </a>
          </li>
          <li>
            <a href={siteConfig.instagramUrl} target="_blank" rel="noopener noreferrer" class="footer-link flex-align">
              <span aria-hidden="true">📸</span> Instagram: @pablocandela.coach
            </a>
          </li>
          <li>
            <a href={`mailto:${siteConfig.contactEmail}`} class="footer-link flex-align">
              <span aria-hidden="true">✉️</span> {siteConfig.contactEmail}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        &copy; {currentYear} {siteConfig.siteName}. Todos los derechos reservados.
      </p>
      <p class="legal-note">
        Sitio web optimizado para velocidad, accesibilidad y privacidad.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-bg-darker);
    color: #94a3b8;
    padding-top: var(--space-16);
    padding-bottom: var(--space-8);
    border-top: 1px solid #1e293b;
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1.5fr 1.5fr;
      gap: var(--space-8);
    }
  }

  .footer-title {
    display: block;
    font-family: var(--font-serif);
    font-size: var(--font-size-2xl);
    font-weight: 700;
    color: #ffffff;
    margin-bottom: var(--space-3);
    letter-spacing: -0.01em;
  }

  .footer-bio {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: #cbd5e1;
    margin-bottom: var(--space-3);
  }

  .footer-book-plug {
    font-size: var(--font-size-sm);
    color: #fdba74;
    font-weight: 500;
  }

  .footer-heading {
    font-family: var(--font-serif);
    color: #ffffff;
    font-size: var(--font-size-lg);
    font-weight: 600;
    margin-bottom: var(--space-4);
    letter-spacing: -0.01em;
  }

  .footer-links,
  .footer-contact-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-link {
    color: #94a3b8;
    font-size: var(--font-size-sm);
    transition: color var(--transition-fast);
  }

  .footer-link:hover {
    color: #ffffff;
  }

  .flex-align {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .footer-bottom {
    padding-top: var(--space-8);
    border-top: 1px solid #1e293b;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: center;
    text-align: center;
    font-size: var(--font-size-xs);
    color: #64748b;
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }
</style>
