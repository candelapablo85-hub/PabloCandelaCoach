---
import { siteConfig } from '../../data/siteConfig';
---

<div class="book-banner-card">
  <div class="book-visual">
    <a 
      href={siteConfig.bookUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="book-link-wrap"
      aria-label="Visitar la web oficial del libro Si la vida te da la espalda... Tocale el culo"
    >
      <img
        class="book-cover"
        src="/Tapa_Libro.png"
        alt={`Tapa del libro «${siteConfig.bookTitle}», de ${siteConfig.author}`}
        loading="lazy"
        decoding="async"
      />
    </a>
  </div>

  <div class="book-info">
    <span class="badge badge-accent">Libro Recomendado</span>
    <h2 class="book-heading">«{siteConfig.bookTitle}»</h2>
    <p class="book-author-line">Por <strong>{siteConfig.author}</strong></p>
    <p class="book-description">
      {siteConfig.bookSubtitle}
    </p>

    <div class="book-features">
      <div class="feature-item">
        <span class="check-icon" aria-hidden="true">✓</span>
        <span>Mirar las derrotas y errores con una sonrisa y sin drama.</span>
      </div>
      <div class="feature-item">
        <span class="check-icon" aria-hidden="true">✓</span>
        <span>Herramientas de liderazgo y coaching aplicadas a la vida real.</span>
      </div>
      <div class="feature-item">
        <span class="check-icon" aria-hidden="true">✓</span>
        <span>Directo, claro y sin vueltas: una conversación entre amigos.</span>
      </div>
    </div>

    <div class="book-actions">
      <a 
        href={siteConfig.bookUrl} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn btn-primary"
      >
        Visitar la Web Oficial del Libro ↗
      </a>
    </div>
  </div>
</div>

<style>
  .book-banner-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    background: linear-gradient(145deg, var(--color-primary) 0%, var(--color-bg-darker) 100%);
    color: #ffffff;
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-lg);
    border: 1px solid rgba(255, 255, 255, 0.1);
    align-items: center;
  }

  @media (min-width: 860px) {
    .book-banner-card {
      grid-template-columns: 280px 1fr;
      padding: var(--space-12);
      gap: var(--space-12);
    }
  }

  .book-visual {
    display: flex;
    justify-content: center;
  }

  .book-link-wrap {
    display: block;
    text-decoration: none;
    transition: transform var(--transition-fast);
  }

  .book-link-wrap:hover {
    transform: translateY(-4px);
  }

  .book-cover {
    display: block;
    width: 210px;
    height: 300px;
    object-fit: cover;
    border-radius: 3px 10px 10px 3px;
    box-shadow: 10px 15px 30px rgba(0, 0, 0, 0.4), inset 4px 0 6px rgba(255, 255, 255, 0.2);
  }

  .book-heading {
    font-family: var(--font-serif);
    color: #ffffff;
    font-size: var(--font-size-2xl);
    margin-top: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .book-author-line {
    color: #fed7aa;
    font-size: var(--font-size-sm);
    margin-bottom: var(--space-4);
  }

  .book-description {
    color: #e2e8f0;
    font-size: var(--font-size-base);
    max-width: var(--max-reading-ch);
    margin-bottom: var(--space-6);
    line-height: 1.7;
  }

  .book-features {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: #f1f5f9;
    font-size: var(--font-size-sm);
  }

  .check-icon {
    color: #fdba74;
    font-weight: bold;
  }

  .book-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
</style>
