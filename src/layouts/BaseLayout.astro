---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SEO from '../components/seo/SEO.astro';
import Analytics from '../components/seo/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article' | 'book';
  noindex?: boolean;
}

const { title, description, canonical, image, type, noindex } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <SEO 
      title={title} 
      description={description} 
      canonical={canonical} 
      image={image} 
      type={type} 
      noindex={noindex} 
    />
    <Analytics />
    <slot name="head" />
  </head>
  <body>
    <!-- Enlace de accesibilidad para saltar navegación directa -->
    <a href="#contenido-principal" class="skip-link">
      Saltar al contenido principal
    </a>

    <Header />

    <main id="contenido-principal">
      <slot />
    </main>

    <Footer />

    <slot name="scripts" />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100px;
    left: 1rem;
    background: var(--color-primary-950);
    color: #ffffff;
    padding: 0.75rem 1.25rem;
    font-weight: 700;
    z-index: 999;
    border-radius: var(--radius-sm);
    transition: top var(--transition-fast);
  }

  .skip-link:focus {
    top: 1rem;
    outline: 2px solid var(--color-accent-600);
  }

  main {
    flex: 1;
  }
</style>
