---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../data/siteConfig';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: any };
const { Content } = await post.render();

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('es-ES', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date);
};

const canonicalUrl = `${siteConfig.siteUrl}/blog/${post.slug}`;
---

<BaseLayout
  title={`${post.data.title} | Blog Pablo Candela`}
  description={post.data.description}
  canonical={canonicalUrl}
  type="article"
>
  <Fragment slot="head">
    <JsonLd
      schema={{
        type: 'Article',
        title: post.data.title,
        description: post.data.description,
        pubDate: post.data.pubDate,
        updatedDate: post.data.updatedDate,
        url: canonicalUrl,
        image: post.data.image ? `${siteConfig.siteUrl}${post.data.image}` : undefined,
        authorName: post.data.author,
      }}
    />
  </Fragment>

  <article class="section blog-post-section">
    <div class="container container-narrow">
      <!-- Breadcrumb de navegación -->
      <nav class="breadcrumb-nav" aria-label="Miga de pan">
        <ol class="breadcrumb-list">
          <li><a href="/">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/blog">Blog</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">{post.data.title}</li>
        </ol>
      </nav>

      <!-- Encabezado del Artículo -->
      <header class="post-header">
        <div class="post-tags-top">
          {post.data.tags.map((tag: string) => (
            <a href={`/blog/etiqueta/${encodeURIComponent(tag.toLowerCase())}`} class="tag-badge">
              #{tag}
            </a>
          ))}
        </div>

        <h1 class="post-h1">{post.data.title}</h1>

        <div class="post-meta-bar">
          <div class="author-block">
            <span class="author-avatar" aria-hidden="true">👤</span>
            <div class="author-meta-info">
              <span class="author-name">Por {post.data.author}</span>
              <span class="author-role">Coach Ontológico & Supervisor Industrial</span>
            </div>
          </div>

          <div class="post-time-meta">
            <time datetime={post.data.pubDate.toISOString()} class="post-pubdate">
              {formatDate(post.data.pubDate)}
            </time>
            <span class="meta-dot" aria-hidden="true">•</span>
            <span class="post-reading-time">{post.data.readingTime}</span>
          </div>
        </div>
      </header>

      <!-- Cuerpo del Artículo Markdown -->
      <div class="prose post-body">
        <Content />
      </div>

      <!-- Pie del Artículo: Etiquetas completas -->
      <footer class="post-footer">
        <div class="footer-tags">
          <span class="footer-tags-label">Categorías:</span>
          {post.data.tags.map((tag: string) => (
            <a href={`/blog/etiqueta/${encodeURIComponent(tag.toLowerCase())}`} class="footer-tag-pill">
              #{tag}
            </a>
          ))}
        </div>
      </footer>

      <!-- Bloque de Conversión al Libro y Coaching -->
      <aside class="post-conversion-banner" aria-label="Recurso recomendado">
        <div class="banner-inner">
          <div class="banner-text">
            <span class="badge badge-accent">Lectura Recomendada</span>
            <h3>¿Te sirvió esta perspectiva para tu liderazgo?</h3>
            <p>
              En mi libro <em>«{siteConfig.bookTitle}»</em> profundizo en estas y otras herramientas forjadas en más de 20 años en la industria y el coaching para liderar con templanza ante la adversidad.
            </p>
            <div class="banner-ctas">
              <a href={siteConfig.bookUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                Conocer la Web del Libro ↗
              </a>
              <a href="/coaching" class="btn btn-outline-white">
                Coaching para Supervisores
              </a>
            </div>
          </div>
        </div>
      </aside>

      <!-- Navegación de vuelta al Blog -->
      <div class="post-bottom-nav">
        <a href="/blog" class="btn btn-outline">
          ← Volver al listado de artículos
        </a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .blog-post-section {
    padding-top: var(--space-8);
    padding-bottom: var(--space-16);
  }

  .breadcrumb-nav {
    margin-bottom: var(--space-6);
  }

  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .breadcrumb-list a {
    color: var(--color-accent-600);
    text-decoration: underline;
  }

  .post-header {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .post-tags-top {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .tag-badge {
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: var(--color-accent-700);
    background-color: var(--color-accent-50);
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    transition: background-color var(--transition-fast);
  }

  .tag-badge:hover {
    background-color: #bae6fd;
  }

  .post-h1 {
    font-family: var(--font-serif);
    font-size: var(--font-size-3xl);
    line-height: 1.2;
    margin-bottom: var(--space-6);
    color: var(--color-primary);
  }

  .post-meta-bar {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .post-meta-bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .author-block {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .author-avatar {
    font-size: 1.75rem;
    background: var(--color-bg-subtle);
    padding: 0.25rem 0.5rem;
    border-radius: 50%;
    border: 1px solid var(--color-border);
  }

  .author-meta-info {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--font-size-sm);
    color: var(--color-primary);
  }

  .author-role {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .post-time-meta {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Estilos del cuerpo de texto Markdown con regla de 70 caracteres */
  .post-body {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--color-text-main);
    margin-bottom: var(--space-12);
  }

  .post-body :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.85rem;
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    color: var(--color-primary);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-2);
  }

  .post-body :global(h3) {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    color: var(--color-primary);
  }

  .post-body :global(p) {
    max-width: var(--max-reading-ch);
    margin-bottom: var(--space-6);
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    max-width: var(--max-reading-ch);
    margin-bottom: var(--space-6);
    padding-left: var(--space-6);
  }

  .post-body :global(ul) {
    list-style: disc;
  }

  .post-body :global(ol) {
    list-style: decimal;
  }

  .post-body :global(li) {
    margin-bottom: var(--space-2);
    line-height: 1.75;
  }

  .post-body :global(blockquote) {
    max-width: var(--max-reading-ch);
    margin: var(--space-8) 0;
    padding: var(--space-5) var(--space-8);
    background-color: var(--color-bg-subtle);
    border-left: 4px solid var(--color-accent);
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-style: italic;
    color: var(--color-primary);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .post-footer {
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    margin-bottom: var(--space-10);
  }

  .footer-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .footer-tags-label {
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .footer-tag-pill {
    font-size: var(--font-size-xs);
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-main);
  }

  .footer-tag-pill:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* Banner de Conversión al Libro */
  .post-conversion-banner {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-bg-darker) 100%);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    color: #ffffff;
    box-shadow: var(--shadow-md);
    margin-bottom: var(--space-10);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .banner-inner h3 {
    font-family: var(--font-serif);
    color: #ffffff;
    font-size: var(--font-size-xl);
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .banner-inner p {
    color: #cbd5e1;
    font-size: var(--font-size-base);
    max-width: var(--max-reading-ch);
    margin-bottom: var(--space-6);
  }

  .banner-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .post-bottom-nav {
    text-align: center;
  }
</style>
