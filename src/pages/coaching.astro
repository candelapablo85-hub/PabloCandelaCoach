---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from '../components/ui/FaqAccordion.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { siteConfig } from '../data/siteConfig';

const pageUrl = `${siteConfig.siteUrl}/coaching`;

const faqItems = [
  {
    question: '¿Cómo sé qué propuesta es la indicada para mí?',
    answer: 'Podés empezar por la etapa en la que estás: autoliderazgo y vida personal, lanzamiento de un proyecto propio o desarrollo de liderazgo y equipos. Si todavía tenés dudas, escribime y lo conversamos.'
  },
  {
    question: '¿Las sesiones son presenciales o virtuales?',
    answer: 'La modalidad y los horarios se coordinan según cada propuesta y tu disponibilidad. Consultame para revisar las opciones antes de empezar.'
  },
  {
    question: '¿Puedo consultar antes de contratar un proceso?',
    answer: 'Sí. Podemos tener una primera conversación para conocer tu situación, tus objetivos y ver qué propuesta se ajusta mejor a lo que necesitás.'
  }
];
---

<BaseLayout
  title="Coaching para cada etapa de tu camino | Pablo Candela"
  description="Explorá propuestas de coaching para tu vida y autoliderazgo, para emprender mientras trabajás y para fortalecer tu liderazgo."
  canonical={pageUrl}
>
  <Fragment slot="head">
    <JsonLd
      schema={{
        type: 'Service',
        name: 'Coaching y desarrollo personal',
        description: 'Propuestas de coaching para autoliderazgo, emprendimiento y liderazgo.',
        url: pageUrl,
        offers: [
          {
            name: 'Libro digital',
            description: 'Acceso al libro digital para leerlo a tu ritmo.',
            price: '10',
            priceCurrency: 'USD',
            url: `${siteConfig.siteUrl}/coaching/autoliderazgo#opciones`,
          },
          {
            name: 'Libro + sesión de arranque',
            description: 'Libro digital y una sesión individual de arranque.',
            price: '30',
            priceCurrency: 'USD',
            url: `${siteConfig.siteUrl}/coaching/autoliderazgo#opciones`,
          },
          {
            name: 'Libro + cuatro sesiones',
            description: 'Libro digital y cuatro sesiones, una por cada bloque del libro, con ejercicios.',
            price: '60',
            priceCurrency: 'USD',
            url: `${siteConfig.siteUrl}/coaching/autoliderazgo#opciones`,
          },
          {
            name: 'Proceso de coaching para emprendedores de seis sesiones',
            description: 'Proceso de seis sesiones para avanzar con un proyecto propio mientras sostenés tu trabajo actual. La primera sesión es gratuita para conocer el proceso.',
            price: '100',
            priceCurrency: 'USD',
            url: `${siteConfig.siteUrl}/coaching/emprendedores`,
          },
          {
            name: 'Programa de liderazgo de los 5 Pilares',
            description: 'Proceso de 12 sesiones para fortalecer el liderazgo.',
            url: `${siteConfig.siteUrl}/coaching/liderazgo`,
          },
        ],
      }}
    />
    <JsonLd schema={{ type: 'FAQPage', items: faqItems }} />
  </Fragment>

  <section class="section coaching-portal">
    <div class="container">
      <header class="section-header coaching-portal-header">
        <span class="badge">Coaching y desarrollo personal</span>
        <h1 class="page-title">Un acompañamiento de coaching para cada etapa de tu camino</h1>
        <p class="section-subtitle">
          Bienvenido. Elegí el proceso que mejor acompaña lo que hoy querés cambiar, iniciar o fortalecer.
        </p>
      </header>

      <div class="coaching-offers" aria-label="Propuestas de coaching">
        <article class="coaching-offer">
          <div class="coaching-offer-body">
            <span class="badge badge-accent">Vida y autoliderazgo</span>
            <h2>Un libro para mirarte y volver a elegir</h2>
            <p>
              «{siteConfig.bookTitle}»: una invitación a revisar cómo te parás frente a lo que te pasa y qué querés hacer con eso.
            </p>
            <a class="coaching-offer-book" href="/coaching/autoliderazgo">
              Conocer el libro <span aria-hidden="true">↗</span>
            </a>
          </div>
          <a class="btn btn-primary coaching-offer-cta" href="/coaching/autoliderazgo">
            Explorar autoliderazgo
          </a>
        </article>

        <article class="coaching-offer">
          <div class="coaching-offer-body">
            <span class="badge">Emprendimiento</span>
            <h2>Empezar algo propio sin dejar tu trabajo</h2>
            <p>
              Un espacio para dar forma a una idea y avanzar paso a paso, compatible con tus horarios y responsabilidades actuales.
            </p>
          </div>
          <a class="btn btn-primary coaching-offer-cta" href="/coaching/emprendedores">
            Explorar coaching para emprendedores
          </a>
        </article>

        <article class="coaching-offer coaching-offer-premium">
          <div class="coaching-offer-body">
            <div class="coaching-offer-labels">
              <span class="badge badge-accent">Programa premium</span>
              <span class="coaching-session-count">Proceso de 12 sesiones</span>
            </div>
            <h2>Liderazgo: Programa de los 5 Pilares</h2>
            <p>
              Un recorrido para fortalecer tu forma de estar, comunicar, decidir, trabajar con personas y gestionar el contexto.
            </p>
          </div>
          <a class="btn btn-primary coaching-offer-cta" href="/coaching/liderazgo">
            Ver el programa completo
          </a>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-subtle coaching-choice">
    <div class="container">
      <div class="section-header">
        <span class="badge">Cómo elegir</span>
        <h2>Empezá por lo que hoy necesitás</h2>
      </div>
      <div class="coaching-choice-grid">
        <p><strong>Vida y autoliderazgo:</strong> si querés revisar tu manera de afrontar lo que te pasa y tomar nuevas decisiones.</p>
        <p><strong>Emprendedores:</strong> si querés probar una idea propia mientras mantenés tu trabajo actual.</p>
        <p><strong>Los 5 Pilares:</strong> si buscás un proceso para fortalecer tu liderazgo y tu forma de trabajar con equipos.</p>
      </div>
    </div>
  </section>

  <section class="section coaching-faq" id="faq">
    <div class="container container-narrow">
      <div class="section-header">
        <span class="badge">Dudas habituales</span>
        <h2>Preguntas frecuentes</h2>
      </div>
      <FaqAccordion items={faqItems} />
    </div>
  </section>

  <section class="section section-dark coaching-portal-cta">
    <div class="container container-narrow text-center">
      <span class="badge badge-accent">Una primera conversación</span>
      <h2>¿No sabés por dónde empezar?</h2>
      <p>
        Contame qué te gustaría cambiar o poner en marcha y vemos juntos cuál puede ser el próximo paso.
      </p>
      <a class="btn btn-primary btn-lg" href="/contacto">
        Conversar sobre mi situación
      </a>
      <p class="coaching-blog-link">
        También podés leer las <a href="/blog">ideas y herramientas del blog</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .coaching-portal-header {
    max-width: 860px;
    margin: 0 auto var(--space-12);
  }

  .coaching-portal-header .page-title {
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
    color: var(--color-primary);
  }

  .coaching-offers {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: stretch;
  }

  .coaching-offer {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-surface);
    box-shadow: var(--shadow-sm);
  }

  .coaching-offer-body {
    flex: 1;
  }

  .coaching-offer h2 {
    margin: var(--space-3) 0;
    color: var(--color-primary);
    font-size: var(--font-size-xl);
  }

  .coaching-offer p {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .coaching-offer-book {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    color: var(--color-primary);
    font-size: var(--font-size-sm);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .coaching-offer-cta {
    width: 100%;
    min-height: 3.25rem;
  }

  .coaching-offer-premium {
    border: 2px solid var(--color-accent);
  }

  .coaching-offer-labels {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .coaching-session-count {
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    font-weight: 600;
  }

  .coaching-choice .section-header {
    margin-bottom: var(--space-8);
  }

  .coaching-choice-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .coaching-choice-grid p {
    margin: 0;
    padding-left: var(--space-4);
    border-left: 2px solid var(--color-accent);
    font-size: var(--font-size-sm);
  }

  .coaching-portal-cta h2 {
    color: #fff;
  }

  .coaching-portal-cta p {
    margin: 0 auto var(--space-6);
    color: #e2e8f0;
  }

  .coaching-blog-link {
    margin-top: var(--space-6) !important;
    font-size: var(--font-size-sm);
  }

  .coaching-blog-link a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 768px) {
    .coaching-offers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .coaching-choice-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
