---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/siteConfig';

// Redirección inmediata a la web oficial del libro
return Astro.redirect(siteConfig.bookUrl, 301);
---

<BaseLayout
  title={`Libro: ${siteConfig.bookTitle} | ${siteConfig.siteName}`}
  description={siteConfig.bookSubtitle}
  canonical={siteConfig.bookUrl}
>
  <section class="section text-center">
    <div class="container container-narrow">
      <span class="badge">Redirigiendo</span>
      <h1>«{siteConfig.bookTitle}»</h1>
      <p>
        Te estamos redirigiendo a la web oficial del libro...
      </p>
      <div style="margin-top: 2rem;">
        <a href={siteConfig.bookUrl} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
          Hacé clic aquí si no sos redirigido automáticamente ↗
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
